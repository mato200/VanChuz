# Normalise line endings in the repository.
#   * text files are stored with LF in the repo
#   * shell scripts must be LF or bash on Linux will refuse to run them
#   * Windows scripts and batch files are checked out with CRLF
* text=auto

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
