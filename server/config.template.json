{
  "_comment": [
    "Reference copy of the server configuration that install-server.sh renders.",
    "The real file is generated on the server with fresh secrets and your own",
    "IP address, at /opt/vps/config/config.json. Do not edit this file to",
    "customise a deployment - edit the installer instead.",
    "The placeholders below are substituted by the installer:"
  ],
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": 443,
      "up_mbps": 200,
      "down_mbps": 1000,
      "obfs": {
        "type": "salamander",
        "password": "<GENERATED_OBFS_PASSWORD>"
      },
      "users": [
        {
          "name": "vanchuz",
          "password": "<GENERATED_HY2_PASSWORD>"
        }
      ],
      "masquerade": {
        "type": "proxy",
        "url": "https://www.microsoft.com"
      },
      "tls": {
        "enabled": true,
        "server_name": "<YOUR_SERVER_IP>",
        "certificate_path": "/opt/vps/certs/server.crt",
        "key_path": "/opt/vps/certs/server.key",
        "alpn": ["h3"]
      }
    },
    {
      "type": "shadowsocks",
      "tag": "ss-in",
      "listen": "::",
      "listen_port": 443,
      "method": "2022-blake3-aes-128-gcm",
      "password": "<GENERATED_SS_KEY_BASE64_16_BYTES>",
      "network": "tcp"
    },
    {
      "type": "mixed",
      "tag": "local-mixed",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "rules": [
      { "inbound": ["local-mixed"], "action": "route", "outbound": "direct" }
    ],
    "final": "direct",
    "auto_detect_interface": true
  }
}
